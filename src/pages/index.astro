---
import '../styles/global.css';

const projects = [
  {
    number: '01',
    label: 'Source integration',
    title: 'AROS-NX',
    description:
      'An upstream-synchronized integration fork where compatibility work stays reviewable, separable, and ready for upstream submission.',
    primary: { label: 'Explore the source', href: 'https://github.com/metaneutrons/AROS-NX' },
    secondary: { label: 'Upstream AROS', href: 'https://github.com/aros-development-team/AROS' },
    tone: 'cyan',
  },
  {
    number: '02',
    label: 'Developer workflow',
    title: 'AROS tools',
    description:
      'A typed, upstream-compatible host suite for source checkout, translation, builds, verification, diagnostics, and physical boards.',
    primary: { label: 'Read the documentation', href: '/aros-tools/' },
    secondary: { label: 'Browse the code', href: 'https://github.com/metaneutrons/aros-tools' },
    tone: 'lime',
  },
  {
    number: '03',
    label: 'Supply chain',
    title: 'Deterministic toolchains',
    description:
      'Reproducible cross-compilers for four development hosts and three AROS target profiles, qualified with checksums, SBOMs, and provenance.',
    primary: { label: 'Toolchain releases', href: 'https://github.com/metaneutrons/aros-toolchains/releases' },
    secondary: { label: 'Qualification source', href: 'https://github.com/metaneutrons/aros-toolchains' },
    tone: 'violet',
  },
  {
    number: '04',
    label: 'Distribution',
    title: 'System images',
    description:
      'A planned, separately verified channel for bootable machine and board images. Publication begins only when hardware evidence is complete.',
    primary: { label: 'See the roadmap', href: '#roadmap' },
    secondary: null,
    tone: 'orange',
  },
];

const principles = [
  {
    title: 'Upstream first',
    copy: 'Extensions remain isolated from the synchronized source baseline, making review and contribution practical.',
  },
  {
    title: 'Measured releases',
    copy: 'Byte identity, relocation, compatibility, checksums, SBOMs, and provenance are gates—not release notes.',
  },
  {
    title: 'Explicit failure',
    copy: 'No hidden fallback or stale pin turns a broken assumption into a plausible-looking build.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Upstream-first source integration, deterministic toolchains, developer workflows, and verified system images for AROS." />
    <meta name="theme-color" content="#071014" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AROS — engineering for the next build" />
    <meta property="og:description" content="A reproducible engineering layer for the open AROS ecosystem." />
    <meta property="og:url" content="https://aros.metaneutrons.cc/" />
    <meta property="og:image" content="https://aros.metaneutrons.cc/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="AROS — engineering for the next build" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://aros.metaneutrons.cc/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>AROS — engineering for the next build</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AROS engineering',
      url: 'https://aros.metaneutrons.cc/',
      description: 'A reproducible engineering layer for the open AROS ecosystem.',
    })}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="AROS home">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span>AROS</span>
        <span class="beta-badge" aria-label="Beta — not production-ready">Beta</span>
        <span class="brand-subtitle">engineering</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#ecosystem">Ecosystem</a>
        <a href="#principles">Principles</a>
        <a href="#roadmap">Roadmap</a>
        <a class="nav-github" href="https://github.com/metaneutrons" aria-label="metaneutrons on GitHub">
          GitHub
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.2 3.5h7.3v7.3h-1.4V5.9l-6.6 6.6-1-1 6.6-6.6H5.2Z"/></svg>
        </a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Open · reproducible · upstream-first</p>
          <h1 id="hero-title">AROS, engineered<br />for the <em>next build.</em></h1>
          <p class="hero-lede">
            A modern engineering layer for AROS: synchronized source, deterministic
            cross-toolchains, dependable developer workflows, and evidence-driven releases.
          </p>
          <div class="button-row">
            <a class="button primary" href="/aros-tools/">Start with AROS tools</a>
            <a class="button secondary" href="https://github.com/metaneutrons/AROS-NX">View AROS-NX</a>
          </div>
          <p class="independence">Independent engineering around the upstream AROS project.</p>
        </div>

        <div class="build-card" aria-label="Example AROS build workflow">
          <div class="window-bar">
            <div><span></span><span></span><span></span></div>
            <p>aros · pc-x86_64</p>
            <p>01</p>
          </div>
          <div class="terminal">
            <p><span class="prompt">$</span> aros source init ~/Source/AROS-NX <span class="continuation">\</span></p>
            <p class="indent">--upstream https://github.com/metaneutrons/AROS-NX.git <span class="continuation">\</span></p>
            <p class="indent">--ref refs/heads/main</p>
            <p class="response"><span>✓</span> source identity verified</p>
            <p><span class="prompt">$</span> aros setup --preset pc-x86_64</p>
            <p class="response"><span>✓</span> toolchain checksum verified</p>
            <p><span class="prompt">$</span> aros build --preset pc-x86_64</p>
            <p class="response"><span>✓</span> build graph ready</p>
            <p class="cursor-line"><span class="prompt">$</span><span class="cursor"></span></p>
          </div>
          <div class="signal signal-one"><i></i><i></i><i></i></div>
          <div class="signal signal-two"><i></i><i></i></div>
        </div>

        <div class="hero-index" aria-hidden="true">
          <span>68K</span><span>X86</span><span>ARM</span><span>RISCV</span>
        </div>
      </section>

      <section class="manifesto" aria-label="Project statement">
        <p class="section-tag">The objective</p>
        <p>
          Keep AROS recognizable at the source boundary while making every step around it
          {' '}<strong>repeatable, inspectable, and easier to contribute upstream.</strong>
        </p>
      </section>

      <section class="ecosystem section-shell" id="ecosystem" aria-labelledby="ecosystem-title">
        <div class="section-heading">
          <div>
            <p class="section-tag">One system · clear boundaries</p>
            <h2 id="ecosystem-title">The engineering stack</h2>
          </div>
          <p>Each component has one job, one release boundary, and an explicit relationship with upstream AROS.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class={`project-card ${project.tone}`}>
              <div class="card-topline">
                <span>{project.number}</span>
                <span>{project.label}</span>
              </div>
              <div class="card-orbit" aria-hidden="true"><span></span><span></span></div>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="card-links">
                <a href={project.primary.href}>{project.primary.label}<span aria-hidden="true">↗</span></a>
                {project.secondary && <a href={project.secondary.href}>{project.secondary.label}</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="pipeline section-shell" aria-labelledby="pipeline-title">
        <div class="section-heading compact">
          <div>
            <p class="section-tag">Source to target</p>
            <h2 id="pipeline-title">A visible chain of trust</h2>
          </div>
        </div>
        <ol class="pipeline-list">
          <li><span>01</span><strong>Synchronize</strong><small>Upstream source identity</small></li>
          <li><span>02</span><strong>Translate</strong><small>Explicit build semantics</small></li>
          <li><span>03</span><strong>Compile</strong><small>Released cross-toolchain</small></li>
          <li><span>04</span><strong>Verify</strong><small>Independent evidence</small></li>
          <li><span>05</span><strong>Run</strong><small>Virtual or physical target</small></li>
        </ol>
      </section>

      <section class="principles section-shell" id="principles" aria-labelledby="principles-title">
        <div class="section-heading">
          <div>
            <p class="section-tag">Engineering principles</p>
            <h2 id="principles-title">Strict where it matters.</h2>
          </div>
          <p>Modern tooling should make the difficult parts visible without obscuring the system it serves.</p>
        </div>
        <div class="principle-grid">
          {principles.map((principle, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="roadmap section-shell" id="roadmap" aria-labelledby="roadmap-title">
        <div class="roadmap-copy">
          <p class="section-tag">Current horizon</p>
          <h2 id="roadmap-title">Builds first.<br />Claims second.</h2>
          <p>
            AROS tools is completing its initial public qualification. Deterministic toolchains
            are available as prereleases. System images follow only after repeatable build and
            real-hardware boot evidence.
          </p>
          <a class="text-link" href="/aros-tools/reference/release-status/">Read the measured release status <span aria-hidden="true">→</span></a>
        </div>
        <div class="status-board" aria-label="Ecosystem publication status">
          <div><span class="status-dot live"></span><strong>Source</strong><small>Public · synchronized</small></div>
          <div><span class="status-dot active"></span><strong>Tools</strong><small>Initial qualification</small></div>
          <div><span class="status-dot live"></span><strong>Toolchains</strong><small>Public prerelease</small></div>
          <div><span class="status-dot planned"></span><strong>Images</strong><small>Evidence pending</small></div>
        </div>
      </section>

      <section class="closing">
        <div>
          <p class="section-tag">Begin at the boundary</p>
          <h2>Use the tools beside upstream AROS.</h2>
        </div>
        <div class="button-row">
          <a class="button primary" href="/aros-tools/getting-started/quick-start/">Open the quick start</a>
          <a class="button secondary" href="https://github.com/aros-development-team/AROS">Visit upstream AROS</a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand" href="/" aria-label="AROS home">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span>AROS</span>
      </a>
      <p>Independent, open engineering around upstream AROS.</p>
      <div>
        <a href="https://github.com/metaneutrons">GitHub</a>
        <a href="https://github.com/metaneutrons/aros-site/blob/main/LICENSE">GPL-3.0-or-later</a>
      </div>
    </footer>
  </body>
</html>
