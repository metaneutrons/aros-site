---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#071014" />
    <title>Not found — AROS</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="error-page">
    <main>
      <a class="brand" href="/" aria-label="AROS home">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span>AROS</span>
      </a>
      <p class="eyebrow">404 · Route not found</p>
      <h1>This path is not part of the build.</h1>
      <p>Return to the engineering hub or open the AROS tools documentation.</p>
      <div class="button-row">
        <a class="button primary" href="/">Back to AROS</a>
        <a class="button secondary" href="/aros-tools/">Read the docs</a>
      </div>
    </main>
  </body>
</html>
